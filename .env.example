# Client-visible film catalogue keys (existing guest mode).
VITE_TMDB_KEY=
VITE_OMDB_KEY=

# Server only. Never use a VITE_ prefix for these values.
APP_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TMDB_KEY=

# Enable only after configuring the Google OAuth provider in Supabase.
GOOGLE_AUTH_ENABLED=false

# Optional Trakt integration: register the exact callback in your Trakt app.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# 32 random bytes encoded as base64 (see README). Keep stable across deployments.
INTEGRATION_ENCRYPTION_KEY=

# Optional conversational interpretation. Without both, guided chat still works.
OPENAI_API_KEY=
# Choose a model in your OpenAI project that supports Responses Structured Outputs.
OPENAI_CHAT_MODEL=
